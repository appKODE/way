digraph DslParityNested {
  package = "ru.kode.way.dslparity.nested"

  // Mirrored by DslParityTest.kt: a parallel under a flow whose region holds another parallel. The DSL graph also has a
  // history of the outer parallel, which codegen lists as a region and fails to build.
  main [type = flow]
  tabs [type = parallelFlow]
  left [type = flow]
  inner [type = parallelFlow]
  right [type = flow]
  feed [type = schema]

  main -> start
  main -> tabs
  tabs -> left -> leftScreen -> leftDetails
  left -> inner
  inner -> right -> rightScreen
  inner -> feed
}
