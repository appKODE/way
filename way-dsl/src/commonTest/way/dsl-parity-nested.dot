digraph DslParityNested {
  package = "ru.kode.way.dslparity.nested"

  // Mirrored by DslParityTest.kt: a parallel under a flow whose region holds another parallel, with a deep history of
  // the outer parallel.
  main [type = flow]
  tabs [type = parallelFlow]
  left [type = flow]
  inner [type = parallelFlow]
  right [type = flow]
  feed [type = schema]
  tabsHistory [type = deepHistory]

  main -> start
  main -> tabs
  tabs -> left -> leftScreen -> leftDetails
  left -> inner
  inner -> right -> rightScreen
  inner -> feed
  tabs -> tabsHistory
}
